  <XDFTABLE uniqueid="0x13AB" flags="0x0">
    <title>B5 AD Acceleration enrichment</title>
    <description>The accel/decel values counteract the temporary condensation of fuel on the intake walls when the throttle is opened and the evaporation when the throttle is closed.&#013;&#010;&#013;&#010;The values are added to left and right cylinder fuel map values during throttle opening. &#013;&#010;A decrease in values increases the sensitivity to the speed of TPS change. 0 is lowest, 255 is highest.&#013;&#010;&#013;&#010;Meinolf</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="2" />
    <CATEGORYMEM index="2" category="1" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xB0D9" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>TPS Degrees</units>
      <indexcount>16</indexcount>
      <min>1000.000000</min>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x5031" />
      <datatype>57</datatype>
      <unittype>23</unittype>
      <DALINK index="0" />
      <MATH equation="(X/411)">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xB139" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>RPM</units>
      <indexcount>16</indexcount>
      <decimalpl>1</decimalpl>
      <min>1000.000000</min>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x47EE" />
      <datatype>6</datatype>
      <unittype>4</unittype>
      <DALINK index="0" />
      <MATH equation="X*.25">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedaddress="0xB5AD" mmedelementsizebits="8" mmedrowcount="16" mmedcolcount="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>Injection duration &#181;s</units>
