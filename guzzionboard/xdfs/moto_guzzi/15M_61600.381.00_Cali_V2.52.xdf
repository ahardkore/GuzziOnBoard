  <XDFTABLE uniqueid="0x36C2" flags="0x30">
    <title>Idle Ignition B5A7</title>
    <description>The values (&#176;BTDC) in this map are used to adjust the engine speed via spark changes while idling. Only active if TPS status is &quot;TPS Closed&quot;, regardless of engine rpm.&#013;&#010;&#013;&#010;Meinolf</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="1" />
    <CATEGORYMEM index="2" category="8" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>&#176; BTDC</units>
      <indexcount>1</indexcount>
      <decimalpl>1</decimalpl>
      <datatype>38</datatype>
      <unittype>23</unittype>
      <DALINK index="0" />
      <LABEL index="0" value="0.0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xAFC7" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>RPM</units>
      <indexcount>16</indexcount>
      <decimalpl>0</decimalpl>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x2DF2" />
      <datatype>6</datatype>
      <unittype>4</unittype>
      <DALINK index="0" />
      <MATH equation="X/4">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedaddress="0xB5A7" mmedelementsizebits="8" mmedrowcount="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>&#176; BTDC</units>
      <decimalpl>1</decimalpl>
      <min>0.000000</min>
      <max>55.000000</max>
      <outputtype>1</outputtype>
      <MATH equation="X/2">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFTABLE>
  <XDFTABLE uniqueid="0x1973" flags="0x0">
    <title>Start enrichment map B7B8</title>
    <description>The values are used during the duration of the coldstart cycle. The values are factors applied to the base fuel maps values.&#013;&#010;&#013;&#010;The duration is engine revolutions since start and counted down from highest to lowest value in 16 steps. The breakpoints are in the table beginning at $B7B8, the total number of revolutions is stored at $B7B5&#013;&#010;&#013;&#010;Meinolf</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="2" />
    <CATEGORYMEM index="2" category="3" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xAF87" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>Engine Revolutions</units>
      <indexcount>16</indexcount>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x17AB" />
      <datatype>6</datatype>
      <unittype>4</unittype>
      <DALINK index="0" />
      <MATH equation="(X/413)">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xAFC7" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>&#176;C</units>
      <indexcount>16</indexcount>
      <decimalpl>0</decimalpl>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x6516" />
      <datatype>13</datatype>
      <unittype>15</unittype>
      <DALINK index="0" />
      <MATH equation="X*.25">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedtypeflags="0x04" mmedaddress="0xB7B8" mmedelementsizebits="8" mmedrowcount="16" mmedcolcount="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>%</units>
      <decimalpl>2</decimalpl>
      <min>0.000000</min>
      <max>255.000000</max>
      <outputtype>1</outputtype>
      <MATH equation="(X*100)/3200">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFTABLE>
  <XDFTABLE uniqueid="0x17AB" flags="0x0">
    <title>Start enrichment map points B798</title>
    <description>The total number of revolutions should be the same as the one used at B7B5 (Cold start time)</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="2" />
    <CATEGORYMEM index="2" category="3" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>Revolutions</units>
      <indexcount>1</indexcount>
      <outputtype>2</outputtype>
      <datatype>6</datatype>
      <unittype>4</unittype>
      <DALINK index="0" />
      <LABEL index="0" value="01" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>Step</units>
      <indexcount>16</indexcount>
      <outputtype>4</outputtype>
      <datatype>0</datatype>
      <unittype>27</unittype>
      <DALINK index="0" />
      <LABEL index="0" value="1" />
      <LABEL index="1" value="2" />
      <LABEL index="2" value="3" />
      <LABEL index="3" value="4" />
      <LABEL index="4" value="5" />
      <LABEL index="5" value="6" />
      <LABEL index="6" value="7" />
      <LABEL index="7" value="8" />
      <LABEL index="8" value="9" />
      <LABEL index="9" value="10" />
      <LABEL index="10" value="11" />
      <LABEL index="11" value="12" />
      <LABEL index="12" value="13" />
      <LABEL index="13" value="14" />
      <LABEL index="14" value="15" />
      <LABEL index="15" value="16" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedaddress="0xB798" mmedelementsizebits="16" mmedrowcount="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>Revs</units>
      <decimalpl>1</decimalpl>
      <min>-20.000000</min>
      <max>55.000000</max>
      <outputtype>2</outputtype>
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFTABLE>
  <XDFTABLE uniqueid="0x7A52" flags="0x30">
    <title>Fuel trim air temperature Idle B2B8</title>
    <description>The values are used as factor on the sum of the values from the fuel maps. E.g., a value of 10 means the factor used is 1.1 . This map is used in Idle (TPS closed)&#013;&#010;(Meinolf)</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="2" />
    <CATEGORYMEM index="2" category="3" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xB027" mmedelementsizebits="8" mmedcolcount="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>% Trim</units>
      <indexcount>1</indexcount>
      <decimalpl>0</decimalpl>
      <datatype>46</datatype>
      <unittype>67</unittype>
      <DALINK index="0" />
      <LABEL index="0" value="0" />
      <MATH equation="x-55">
        <VAR id="x" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>&#176;C</units>
      <indexcount>16</indexcount>
      <embedinfo type="3" linkobjid="0x647D" />
      <datatype>19</datatype>
      <unittype>15</unittype>
      <DALINK index="0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedaddress="0xB2B8" mmedelementsizebits="8" mmedrowcount="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>%</units>
      <decimalpl>2</decimalpl>
      <min>-30.000000</min>
      <max>130.000000</max>
      <outputtype>1</outputtype>
      <MATH equation="(X-128)/1.28">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFTABLE>
