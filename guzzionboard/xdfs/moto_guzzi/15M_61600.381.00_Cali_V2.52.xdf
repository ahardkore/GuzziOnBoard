    <description>Defines Voltage of temperature breakpoints. &#013;&#010;Formula is X=(5V/256), 256 being the resolution of the 8bit A/D in the ECU</description>
    <CATEGORYMEM index="0" category="6" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>Volt</units>
      <indexcount>1</indexcount>
      <outputtype>2</outputtype>
      <datatype>13</datatype>
      <unittype>1</unittype>
      <DALINK index="0" />
      <LABEL index="0" value="00" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>&#176;C</units>
      <indexcount>16</indexcount>
      <embedinfo type="3" linkobjid="0xB5C" />
      <datatype>13</datatype>
      <unittype>15</unittype>
      <DALINK index="0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedaddress="0xB037" mmedelementsizebits="8" mmedrowcount="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>Volt</units>
      <decimalpl>2</decimalpl>
      <min>-20.000000</min>
      <max>55.000000</max>
      <outputtype>1</outputtype>
      <MATH equation="X*(5/256)">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFTABLE>
