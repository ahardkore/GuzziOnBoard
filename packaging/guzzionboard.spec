# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller recipe: the GuzziOnBoard desktop application.

    pyinstaller --noconfirm --clean packaging/guzzionboard.spec

produces, in the dist directory, an on-folder build:

    GuzziOnBoard/
      GuzziOnBoard.exe            the application (windowed; no console)
      GuzziOnBoard-worker.exe     isolated checksum-plugin worker (console)
      web/                        the UI
      guzzionboard/catalog| xdfs  ECU definitions and the XDF library
      vendor/                     mirrored tooling incl. the FTDI CDM bundle
      packaging/icons/            window/app icon

Two executables, on purpose. The checksum worker must run in its own process
(it is how a user-supplied plugin is contained), and a windowed build has no
console to run one in, so a second *console* executable is shipped for it -
built directly from ``guzzionboard/checksum_worker.py``, which is stdlib-only,
so it stays small and does not drag the workstation in with it.

One-folder rather than one-file: a one-file build unpacks the whole 30 MB
bundle into a temporary directory on *every* launch (and every worker call,
which has a 4-second timeout). A folder install is one directory the
uninstaller removes, and starts instantly.

Environment:
    GOB_VERSION   version string for the exe metadata (default: the package's)
    GOB_ICON      path to the .ico (default: packaging/icons/guzzionboard.ico)
"""
import os
import sys
from pathlib import Path

SPEC_ROOT = Path(SPECPATH).resolve()          # .../packaging
ROOT = SPEC_ROOT.parent                       # the repository root
DIST_NAME = "GuzziOnBoard"


def package_version() -> str:
    text = (ROOT / "guzzionboard" / "__init__.py").read_text(encoding="utf-8")
    for line in text.splitlines():
        if line.startswith("__version__"):
            return line.split("=", 1)[1].strip().strip('"').strip("'")
    return "0.0.0"


VERSION = os.environ.get("GOB_VERSION") or package_version()
ICON = Path(os.environ.get("GOB_ICON") or SPEC_ROOT / "icons" / "guzzionboard.ico")

# Everything the runtime reads from the bundle. The frozen layout mirrors the
# repository, so `Path(__file__).parent.parent` inside guzzionboard/ resolves
# into the bundle with no special case (see guzzionboard/resources.py).
datas = [
    (str(ROOT / "web"), "web"),
    (str(ROOT / "guzzionboard" / "catalog"), "guzzionboard/catalog"),
    (str(ROOT / "guzzionboard" / "xdfs"), "guzzionboard/xdfs"),
    (str(ROOT / "vendor"), "vendor"),
    (str(SPEC_ROOT / "icons" / "guzzionboard.png"), "packaging/icons"),
    (str(SPEC_ROOT / "icons" / "guzzionboard.ico"), "packaging/icons"),
]
for extra in ("README.md", "docs"):
    if (ROOT / extra).exists():
        datas.append((str(ROOT / extra), extra))

# Optional hardware transports: imported lazily by the transports, so they
# must be named here or a frozen build loses them.
hiddenimports = []
if os.environ.get("GOB_WITH_HARDWARE") == "1":
    hiddenimports += ["serial", "serial.tools.list_ports", "can", "can.interfaces"]

# Never bundle the test suite's browser tooling or other checkouts.
excludes = ["playwright", "pytest", "PIL", "tkinter", "unittest"]

app_analysis = Analysis(
    [str(SPEC_ROOT / "entry_app.py")],
    pathex=[str(ROOT)],
    binaries=[],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
)

# The worker is stdlib-only, built from its own source file, and carries no
# application data: it must stay cheap to start.
worker_analysis = Analysis(
    [str(ROOT / "guzzionboard" / "checksum_worker.py")],
    pathex=[],
    binaries=[],
    datas=[],
    hiddenimports=[],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
)

app_pyz = PYZ(app_analysis.pure, app_analysis.scripts, app_analysis.binaries, app_analysis.datas)
worker_pyz = PYZ(worker_analysis.pure, worker_analysis.scripts,
                 worker_analysis.binaries, worker_analysis.datas)

# Windows version metadata, so the exe has a real name and version in Explorer
# and in the installer's file list.
VERSION_RESOURCE = None
if sys.platform == "win32":
    version_file = SPEC_ROOT / "windows_version_info.txt"
    version_file.write_text(
        f"""# Generated by packaging/guzzionboard.spec - do not edit.
VSVersionInfo(
  ffi=FixedFileInfo(
    filevers=({", ".join(VERSION.split(".")[:4] + ["0"] * (4 - len(VERSION.split(".")[:4])))}, 0),
    prodvers=({", ".join(VERSION.split(".")[:4] + ["0"] * (4 - len(VERSION.split(".")[:4])))}, 0),
    mask=0x3f, flags=0x0, OS=0x40004, fileType=0x1, subtype=0x0, date=(0, 0)
  ),
  kids=[
    StringFileInfo([
      StringTable('040904B0', [
        StringStruct('CompanyName', 'GuzziOnBoard'),
        StringStruct('FileDescription', 'GuzziOnBoard diagnostic workstation'),
        StringStruct('FileVersion', '{VERSION}'),
        StringStruct('InternalName', 'GuzziOnBoard'),
        StringStruct('OriginalFilename', 'GuzziOnBoard.exe'),
        StringStruct('ProductName', 'GuzziOnBoard'),
        StringStruct('ProductVersion', '{VERSION}'),
        StringStruct('LegalCopyright', 'MIT licensed'),
        StringStruct('Comments', 'Not affiliated with Piaggio, Moto Guzzi, Magneti Marelli or the GuzziDiag author.'),
      ])
    ]),
    VarFileInfo([VarStruct('Translation', [1033, 1200])])
  ]
)
""",
        encoding="utf-8",
    )
    VERSION_RESOURCE = str(version_file)

exe_app = EXE(
    app_pyz,
    app_analysis.scripts,
    [],
    exclude_binaries=True,
    name=DIST_NAME,
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,              # a windowed application: no console window
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=str(ICON) if ICON.is_file() else None,
    version=VERSION_RESOURCE,
)

exe_worker = EXE(
    worker_pyz,
    worker_analysis.scripts,
    [],
    exclude_binaries=True,
    name=f"{DIST_NAME}-worker",
    debug=False,
    console=True,               # a filter: stdin/stdout is the protocol
    strip=False,
    upx=False,
    icon=str(ICON) if ICON.is_file() else None,
)

collect = COLLECT(
    exe_app,
    exe_worker,
    app_analysis.binaries,
    app_analysis.datas,
    worker_analysis.binaries,
    worker_analysis.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name=DIST_NAME,
)

if sys.platform == "darwin":
    # A windowed process needs a real bundle to get focus, a Dock icon and a
    # menu bar. The folder build stays beside it for the worker and for anyone
    # who would rather run the binary directly.
    app_bundle = BUNDLE(
        collect,
        name=f"{DIST_NAME}.app",
        icon=str(ICON) if ICON.is_file() else None,
        bundle_identifier="org.guzzionboard.workstation",
        version=VERSION,
        info_plist={
            "CFBundleName": DIST_NAME,
            "CFBundleDisplayName": DIST_NAME,
            "CFBundleShortVersionString": VERSION,
            "CFBundleVersion": VERSION,
            "LSMinimumSystemVersion": "11.0",
            "LSApplicationCategoryType": "public.app-category.utilities",
            "NSHighResolutionCapable": True,
            "NSRequiresAquaSystemAppearance": False,
            "NSHumanReadableCopyright": (
                "MIT licensed. Not affiliated with Piaggio, Moto Guzzi, Magneti "
                "Marelli or the GuzziDiag author."
            ),
        },
    )
