<XDFFORMAT version="1.50">
  <XDFHEADER>
    <flags>0x1</flags>
    <fileversion>2.47</fileversion>
    <deftitle>15M Marelli</deftitle>
    <description>Reseach BIN for 15M ECU, all known tables and scalars included. Undocumented ones are grouped under &quot;Not verified&quot;. Those where different values where found are grouped under &quot;Difference found in ..., see comment&quot;&#013;&#010;&#013;&#010;&#013;&#010;A Value of 1 corresponds to 64 microseconds injection pulse width &#013;&#010;</description>
    <author>916 RS / DiLo / pauldaytona / beard / Meinolf</author>
    <baseoffset>0</baseoffset>
    <DEFAULTS datasizeinbits="8" sigdigits="1" outputtype="2" signed="0" lsbfirst="0" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0xFFFF" regionflags="0x0" name="Binary File" desc="This region describes the bin file edited by this XDF" />
    <CATEGORY index="0x0" name="Spark" />
    <CATEGORY index="0x1" name="Fuel" />
    <CATEGORY index="0x2" name="Fuel Trims" />
    <CATEGORY index="0x3" name="IAW 15M" />
    <CATEGORY index="0x4" name="Tunable" />
    <CATEGORY index="0x5" name="Definition (Read Only)" />
    <CATEGORY index="0x6" name="Not Verified" />
    <CATEGORY index="0x7" name="Spark Trims" />
    <CATEGORY index="0x8" name="Different value found in other BINs" />
    <CATEGORY index="0x9" name="Different value found in TI BIN" />
    <CATEGORY index="0xA" name="Different value found in dual plug BIN" />
    <CATEGORY index="0xB" name="Derived Maps" />
    <CATEGORY index="0xC" name="Quota" />
    <CATEGORY index="0xD" name="Nur in einer Subroutine verwendet" />
    <CATEGORY index="0xE" name="Acceleration" />
  </XDFHEADER>
  <XDFTABLE uniqueid="0x612" flags="0x30">
    <title>Fuel map left cylinder  (base) B097</title>
    <description>A value of 1 corresponds to 64&#181;s injectior opening time pulse width</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="2" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xAFA7" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>TPS Degrees</units>
      <indexcount>16</indexcount>
      <min>1000.000000</min>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x25E5" />
      <datatype>57</datatype>
      <unittype>23</unittype>
      <DALINK index="0" />
      <MATH equation="(X/413)">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xAFE7" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>RPM</units>
      <indexcount>16</indexcount>
      <decimalpl>1</decimalpl>
      <min>1000.000000</min>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x6292" />
      <datatype>6</datatype>
      <unittype>4</unittype>
      <DALINK index="0" />
      <MATH equation="X*.25">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedaddress="0xB097" mmedelementsizebits="8" mmedrowcount="16" mmedcolcount="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>Pulse duration</units>
      <decimalpl>1</decimalpl>
      <min>0.000000</min>
      <max>255.000000</max>
      <outputtype>2</outputtype>
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFTABLE>
  <XDFTABLE uniqueid="0x262C" flags="0x30">
    <title>Fuel map right cylinder (offset) B198</title>
    <description>Offset map. Values at respective breakpoints are added to those of fuel map left cylinder.&#013;&#010;&#013;&#010;A value of 1 corresponds to 64&#181;s injector opening time pulse width</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="2" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xAFA7" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>TPS Degrees</units>
      <indexcount>16</indexcount>
      <min>1000.000000</min>
      <embedinfo type="3" linkobjid="0x25E5" />
      <datatype>57</datatype>
      <unittype>23</unittype>
      <DALINK index="0" />
      <MATH equation="X/413">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xAFE7" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>RPM</units>
      <indexcount>16</indexcount>
      <min>1000.000000</min>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x6292" />
      <datatype>6</datatype>
      <unittype>4</unittype>
      <DALINK index="0" />
      <MATH equation="X*.25">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedaddress="0xB198" mmedelementsizebits="8" mmedrowcount="16" mmedcolcount="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>Injection duration</units>
      <decimalpl>1</decimalpl>
      <min>-128.000000</min>
      <max>127.000000</max>
      <outputtype>2</outputtype>
      <MATH equation="(X-128)">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFTABLE>
  <XDFTABLE uniqueid="0x531" flags="0x30">
    <title>Fuel map right cylinder B198</title>
    <description>Derived map, not stored in BIN. &#013;&#010;&#013;&#010;Offset and base map added to display right cylinder fuel map. Changes in this table will automatically be changed in the Fuel map right cylinder(offset)&#013;&#010;&#013;&#010; (Designed by Paul Minnaert)</description>
    <CATEGORYMEM index="0" category="12" />
    <CATEGORYMEM index="1" category="2" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xAFA7" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>TPS Degrees</units>
      <indexcount>16</indexcount>
      <min>1000.000000</min>
      <embedinfo type="3" linkobjid="0x25E5" />
      <datatype>57</datatype>
      <unittype>23</unittype>
      <DALINK index="0" />
      <MATH equation="X/413">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xAFE7" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>RPM</units>
      <indexcount>16</indexcount>
      <min>1000.000000</min>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x6292" />
      <datatype>6</datatype>
      <unittype>4</unittype>
      <DALINK index="0" />
      <MATH equation="X*.25">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedaddress="0xB198" mmedelementsizebits="8" mmedrowcount="16" mmedcolcount="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>Offset pulse duration</units>
      <decimalpl>1</decimalpl>
      <min>0.000000</min>
      <max>255.000000</max>
      <outputtype>2</outputtype>
      <MATH equation="(X-128)+THAT(1554;ROW();COL();FALSE)">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFTABLE>
  <XDFTABLE uniqueid="0x2187" flags="0x30">
    <title>Accel enrichment map B3A7</title>
    <description>The accel/decel values counteract the temporary condensation of fuel on the intake walls when the throttle is opened and the evaporation when the throttle is closed.&#013;&#010;&#013;&#010;The values are added to left and right cylinder fuel map values during throttle opening. &#013;&#010;A decrease in values increases the sensitivity to the speed of TPS change. 0 is lowest, 255 is highest.&#013;&#010;&#013;&#010;Meinolf</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="2" />
    <CATEGORYMEM index="2" category="3" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xAF87" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>TPS Degrees</units>
      <indexcount>16</indexcount>
      <embedinfo type="3" linkobjid="0x25E5" />
      <datatype>57</datatype>
      <unittype>23</unittype>
      <DALINK index="0" />
      <MATH equation="(X/413)">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0xAFC7" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>RPM</units>
      <indexcount>16</indexcount>
      <decimalpl>0</decimalpl>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x6292" />
      <datatype>6</datatype>
      <unittype>4</unittype>
      <DALINK index="0" />
      <MATH equation="X*.25">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedaddress="0xB3A7" mmedelementsizebits="8" mmedrowcount="16" mmedcolcount="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>Pulse Duration</units>
      <decimalpl>1</decimalpl>
      <min>0.000000</min>
      <max>255.000000</max>
      <outputtype>2</outputtype>
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFTABLE>
