<XDFFORMAT version="1.60">
  <XDFHEADER>
    <flags>0x1</flags>
    <fileversion>1.31</fileversion>
    <deftitle>Two Lambda Morini Corsaroi XDF</deftitle>
    <description>This is for the Norge GT 8V and Stelvio 8V &gt; 2011&#013;&#010;&#013;&#010;V1.29 &#013;&#010;-Added Fuel engine Temp correction(Thanks Beetle)&#013;&#010;-Added Right cylinder Fuel, this is cummulative the left side and the delta value. So the left, main fuel is still leading. (Thanks Impulse_Duc)&#013;&#010;-Added Right cylinder ignition, this is cummulative the left side and the delta value. So the left, main ignition is still leading. &#013;&#010;-Added Speedo correction, to adjust the speedo to be more accurate. &#013;&#010;V1.30&#013;&#010;-Ignition was wrong table. Thanks Gelos&#013;&#010;V1.31&#013;&#010;-Changed warm up time legend&#013;&#010;-Changed  ign. temp TPS legend &#013;&#010;-Found new tables, see Development&#013;&#010;-Changed warmup time values  (auch 1.000 format)&#013;&#010;</description>
    <author>Beard Pauldaytona</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="16" sigdigits="1" outputtype="2" signed="0" lsbfirst="1" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x50000" regionflags="0x0" name="Binary File" desc="This region describes the bin file edited by this XDF" />
    <CATEGORY index="0x0" name="IAW 5AM Morini Two Lambda Corsaro" />
    <CATEGORY index="0x1" name="Tunable" />
    <CATEGORY index="0x2" name="Read Only" />
    <CATEGORY index="0x3" name="Development" />
  </XDFHEADER>
