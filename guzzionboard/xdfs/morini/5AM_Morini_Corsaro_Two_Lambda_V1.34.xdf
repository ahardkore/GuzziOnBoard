  <XDFTABLE uniqueid="0x44B5" flags="0x30">
    <title>Fuel Right</title>
    <description>This value is calculated out of Fuel Main and Fuel Delta.&#013;&#010;Fuel main stays keeping influence on the displayed value here. &#013;&#010;&#013;&#010;This is created for easy output comparison</description>
    <CATEGORYMEM index="0" category="1" />
    <CATEGORYMEM index="1" category="2" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedelementsizebits="16" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>&#176;TPS</units>
      <indexcount>20</indexcount>
      <decimalpl>1</decimalpl>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x3D0A" />
      <datatype>57</datatype>
      <unittype>23</unittype>
      <DALINK index="0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedelementsizebits="16" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>rpm</units>
      <indexcount>32</indexcount>
      <decimalpl>1</decimalpl>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x38F3" />
      <datatype>6</datatype>
      <unittype>4</unittype>
      <DALINK index="0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x4D4EE" mmedelementsizebits="8" mmedrowcount="32" mmedcolcount="20" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <decimalpl>2</decimalpl>
      <min>0.000000</min>
      <max>17255.000000</max>
      <outputtype>2</outputtype>
      <MATH equation="X*THAT(9464;ROW();COL();FALSE)/100">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFTABLE>
