  <XDFCONSTANT uniqueid="0x1ACF">
    <title>AirPressure_LimpHomeValue B77A</title>
    <description>Default to which ECU resorts if values in AirPressure_Min or AirPressure_Max were exceeded.&#013;&#010;&#013;&#010;Meinolf</description>
    <CATEGORYMEM index="0" category="6" />
    <EMBEDDEDDATA mmedaddress="0xB77A" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
