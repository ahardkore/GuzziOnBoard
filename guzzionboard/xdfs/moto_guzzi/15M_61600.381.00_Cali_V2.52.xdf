    <decimalpl>1</decimalpl>
    <datatype>6</datatype>
    <unittype>4</unittype>
    <DALINK index="0" />
    <MATH equation="X">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x461D">
    <title>CO Trim Multiplier B793</title>
    <description>This values (range 0-255) is a factor applied to the CO setting.&#013;&#010;&#013;&#010;80h equals the factor 0&#013;&#010;40h equals the factor 0,5&#013;&#010;C0h equals the factor 1,5&#013;&#010;&#013;&#010;see http://www.guzzi-forum.de/Forum/index.php?topic=23315.30</description>
    <CATEGORYMEM index="0" category="6" />
    <EMBEDDEDDATA mmedaddress="0xB793" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>%</units>
    <decimalpl>0</decimalpl>
    <datatype>0</datatype>
    <unittype>67</unittype>
    <DALINK index="0" />
    <MATH equation="(X/128)*100">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
