<XDFFORMAT version="1.60">
  <XDFHEADER>
    <flags>0x1</flags>
    <fileversion>1.40</fileversion>
    <deftitle>Two Lambda Guzzi XDF</deftitle>
    <description>This XDF is for the Norge GT 8V and Stelvio 8V &gt; 2011. Values in parameters are based on 3222NG01.&#013;&#010;&#013;&#010;V1.29 &#013;&#010;-Added Fuel engine Temp correction(Thanks Beetle)&#013;&#010;-Added Right cylinder Fuel, this is cummulative the left side and the delta value. So the left, main fuel is still leading. (Thanks Impulse_Duc)&#013;&#010;-Added Right cylinder ignition, this is cummulative the left side and the delta value. So the left, main ignition is still leading. &#013;&#010;-Added Speedo correction, to adjust the speedo to be more accurate. &#013;&#010;V1.30&#013;&#010;-Ignition was wrong table. Thanks Gelos&#013;&#010;V1.31&#013;&#010;-Changed warm up time legend&#013;&#010;-Changed  ign. temp TPS legend &#013;&#010;-Found new tables, see Development&#013;&#010;-Changed warmup time values  (1.000 format)&#013;&#010;&#013;&#010;Post-V1.33&#013;&#010;see Readme.txt</description>
    <author>Beard Pauldaytona Meinolf</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="16" sigdigits="1" outputtype="2" signed="0" lsbfirst="1" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x50000" regionflags="0x0" name="Binary File" desc="This region describes the bin file edited by this XDF" />
    <CATEGORY index="0x0" name="IAW 5AM two Lambda Guzzi" />
    <CATEGORY index="0x1" name="Tunable" />
    <CATEGORY index="0x2" name="Read Only" />
    <CATEGORY index="0x3" name="Development" />
    <CATEGORY index="0x4" name="Fuel" />
    <CATEGORY index="0x5" name="Ignition" />
    <CATEGORY index="0x6" name="Legend" />
    <CATEGORY index="0x7" name="Text Block" />
    <CATEGORY index="0x8" name="Present on CANBus" />
    <CATEGORY index="0x9" name="Validated by Meinolf" />
    <CATEGORY index="0xA" name="Scalar" />
    <CATEGORY index="0xB" name="Requires Validation" />
    <CATEGORY index="0xC" name="One and Two Lambda - same values" />
    <CATEGORY index="0xD" name="One and Two Lambda - different values" />
  </XDFHEADER>
