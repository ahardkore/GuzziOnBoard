      <units>rpm</units>
      <indexcount>8</indexcount>
      <outputtype>2</outputtype>
      <embedinfo type="3" linkobjid="0x3552" />
      <datatype>6</datatype>
      <unittype>4</unittype>
      <DALINK index="0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x4D7B0" mmedelementsizebits="16" mmedrowcount="8" mmedcolcount="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>mg/cycle</units>
      <decimalpl>0</decimalpl>
