    <DALINK index="0" />
    <MATH equation="15000000/X">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x1E08">
    <title>Coldstart time B795</title>
    <description>Defines duration in number of revolutions since engine start. The revolutions are counted down towards 0, beginning at the value set here</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="2" />
    <CATEGORYMEM index="2" category="3" />
