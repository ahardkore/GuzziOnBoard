<?xml version='1.0' encoding='utf-8'?>
<XDFFORMAT version="1.60">
  <XDFHEADER>
    <deftitle>Buell B3R2D / BUE2D EEPROM maps (research)</deftitle>
    <description>Source-derived flat XPR EEPROM image; use only with the matching ECM ID and verify definition. Synthetic tests only. Not flash-ready.</description>
    <author>EcmDroid / XBTune; adapted by GuzziOnBoard</author>
    <fileversion>0.1</fileversion>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="8" signed="0" lsbfirst="1" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0xed4" regionflags="0x0" name="XPR EEPROM" desc="Page 0 stored at end" />
  </XDFHEADER>
  <XDFTABLE uniqueid="0x1">
    <title>Tab_Spark_Front</title>
    <XDFAXIS id="x">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x750" mmedelementsizebits="16" />
      <units>RPM</units>
      <indexcount>14</indexcount>
      <MATH equation="X" />
    </XDFAXIS>
    <XDFAXIS id="y">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x746" mmedelementsizebits="8" />
      <units>Load</units>
      <indexcount>10</indexcount>
      <MATH equation="X" />
    </XDFAXIS>
    <XDFAXIS id="z">
