{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guzzionboard.local/schemas/physical-validation-v1.json",
  "title": "GuzziOnBoard physical ECU/dyno validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "kind", "performed_at", "operator", "motorcycle",
    "ecu", "artifacts", "checks", "result"
  ],
  "properties": {
    "schema": { "const": "guzzionboard.physical-validation/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
    "kind": { "enum": ["real-ecu", "dyno"] },
    "performed_at": { "type": "string", "format": "date-time" },
    "operator": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "organization"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 },
        "contact": { "type": "string" }
      }
    },
    "motorcycle": {
      "type": "object", "additionalProperties": false,
      "required": ["make", "model", "year", "configuration"],
      "properties": {
        "make": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
        "vin_redacted": { "type": "string" },
        "configuration": { "type": "string", "minLength": 10 }
      }
    },
    "ecu": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "hardware", "software"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "hardware": { "type": "string", "minLength": 1 },
        "software": { "type": "string", "minLength": 1 },
        "serial_redacted": { "type": "string" }
      }
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["source_sha256", "output_sha256", "xdf_sha256", "plan_sha256"],
      "properties": {
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "output_sha256": { "$ref": "#/$defs/sha256" },
        "xdf_sha256": { "$ref": "#/$defs/sha256" },
        "plan_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dyno": {
      "type": "object", "additionalProperties": false,
      "required": ["make", "model", "serial", "calibration_date", "correction_standard"],
      "properties": {
        "make": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "serial": { "type": "string", "minLength": 1 },
        "calibration_date": { "type": "string", "format": "date" },
        "correction_standard": { "type": "string", "minLength": 1 },
        "weather_station": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": { "enum": ["session", "ecu-readback", "scope", "log", "dyno-run", "photo", "report", "other"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "note": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "incomplete"] },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "result": { "enum": ["pass", "fail", "incomplete"] },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "dyno" } } },
      "then": { "required": ["build", "dyno"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
