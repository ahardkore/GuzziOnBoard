  <XDFCONSTANT uniqueid="0x3686">
    <title>Max RPM B2F8</title>
    <description>Defines rpm at which fuel is cut off</description>
    <CATEGORYMEM index="0" category="6" />
    <EMBEDDEDDATA mmedaddress="0xB2F8" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
