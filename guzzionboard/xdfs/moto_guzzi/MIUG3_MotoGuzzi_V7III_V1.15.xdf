  <XDFTABLE uniqueid="0x1A59" flags="0x30">
    <title>78 B 14 Ignition Main Advance 1</title>
    <description>Use of this table is dependent on Engtemp_above_threshold_flag_8AFD, which switches between usage of the 2 main ignition tables. This flag is always 0, hence this ignition table is used.</description>
    <CATEGORYMEM index="0" category="1" />
    <CATEGORYMEM index="1" category="2" />
    <CATEGORYMEM index="2" category="6" />
    <XDFAXIS id="x" uniqueid="0x0">
