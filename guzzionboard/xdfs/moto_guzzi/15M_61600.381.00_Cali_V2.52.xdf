      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x494E">
    <title>AirPressure_Max B779</title>
    <description>Exceeding this threshold (shortage to plus) causes error message in ECU&#013;&#010;&#013;&#010;Meinolf</description>
    <CATEGORYMEM index="0" category="6" />
