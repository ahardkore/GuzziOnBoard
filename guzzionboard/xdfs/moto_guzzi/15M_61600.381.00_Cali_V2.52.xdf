  <XDFCONSTANT uniqueid="0x1794">
    <title>TPS Initial WOT setting AF50</title>
    <description>Initial value for Wide open throttle (WOT) at which the ECU recognizes TPS is completely open and changes the corresponding status bit. &#013;&#010;&#013;&#010;Meinolf&#013;&#010;&#013;&#010;The address points to the TPS Lookup table at $77AB.&#013;&#010;&#013;&#010;The ECU reads this value and later on adjusts it (in memory only, not in the BIN) following the highest TPS settings actually used during  driving for a yet unspecified duration. It is not clear yet how the moving value influences the usage of the fuel, ignition and other maps. (Meinolf)</description>
    <CATEGORYMEM index="0" category="6" />
    <EMBEDDEDDATA mmedaddress="0xAF50" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <outputtype>3</outputtype>
    <decimalpl>1</decimalpl>
    <datatype>1</datatype>
    <unittype>2</unittype>
    <DALINK index="0" />
    <MATH equation="X">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x567">
    <title>Default CO Trim Value AF67</title>
    <description>Default value used by ECU upon start and reset. Can be overwritten by the value CO Trim Multiplier at $AF67 </description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="2" />
    <CATEGORYMEM index="2" category="3" />
    <EMBEDDEDDATA mmedaddress="0xAF67" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <outputtype>2</outputtype>
    <decimalpl>1</decimalpl>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X - 128">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x48B0">
    <title>FuelMapScaleFactor B197</title>
    <description>This value acts as factor on the values in the fuel maps. The range extends from +6% - +200% (00 to FF)&#013;&#010;&#013;&#010;Meinolf</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="2" />
    <CATEGORYMEM index="2" category="3" />
    <EMBEDDEDDATA mmedaddress="0xB197" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X / 32">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x7034">
    <title>AirPressure_Min B778</title>
    <description>Exceeding this threshold (shortage to minus) causes error message in ECU&#013;&#010;&#013;&#010;Meinolf</description>
    <CATEGORYMEM index="0" category="6" />
